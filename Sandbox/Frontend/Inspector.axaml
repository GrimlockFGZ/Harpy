<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:HarpyEngine.Sandbox.Editor.Models"
             x:Class="HarpyEngine.Sandbox.Editor.Inspector"
             x:DataType="models:InspectorViewModel"
             x:CompileBindings="True">

    <UserControl.Styles>
        <Style Selector="TextBlock.Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#909090"/>
        </Style>

        <Style Selector="TextBox.VectorInput">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#151515"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333"/>
        </Style>

        <Style Selector="TextBox.VectorInput TextBlock.Prefix">
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="12" Spacing="12">
            
            <StackPanel Spacing="4" Margin="0,0,0,12">
                <TextBlock Text="INSPECTOR" 
                           Foreground="#606060" 
                           FontSize="10" 
                           FontWeight="Bold" 
                           LetterSpacing="1"/>
                <Rectangle Height="1" Fill="#333"/>
            </StackPanel>

            <Grid ColumnDefinitions="60, *" Margin="0,4,0,0">
                <TextBlock Grid.Column="0" Text="Name" Classes="Label"/>
                <TextBox Grid.Column="1" 
                         Text="{Binding SelectedEntityName, UpdateSourceTrigger=PropertyChanged}" 
                         FontSize="11"
                         Background="#151515"
                         BorderBrush="#333"
                         HorizontalContentAlignment="Left"/>
            </Grid>

            <Border Background="#282828" 
                    CornerRadius="3" 
                    BorderBrush="#383838" 
                    BorderThickness="1">
                <StackPanel>
                    <Border Background="#333" Padding="8,4">
                        <TextBlock Text="Transform" 
                                   FontSize="11"
                                   Foreground="#CFCFCF"
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Padding="8">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="60, *, *, *">
                                <TextBlock Grid.Column="0" Text="Position" Classes="Label"/>
                                <TextBox Grid.Column="1" Classes="VectorInput" Text="{Binding PositionX, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0">
                                    <TextBox.InnerLeftContent>
                                        <TextBlock Text="X" Classes="Prefix" Foreground="#FF5555"/>
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                                <TextBox Grid.Column="2" Classes="VectorInput" Text="{Binding PositionY, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0">
                                    <TextBox.InnerLeftContent>
                                        <TextBlock Text="Y" Classes="Prefix" Foreground="#55FF55"/>
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                                <TextBox Grid.Column="3" Classes="VectorInput" Text="{Binding PositionZ, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InnerLeftContent>
                                        <TextBlock Text="Z" Classes="Prefix" Foreground="#5555FF"/>
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                            </Grid>

                            <Grid ColumnDefinitions="60, *, *, *">
                                <TextBlock Grid.Column="0" Text="Scale" Classes="Label"/>
                                <TextBox Grid.Column="1" Classes="VectorInput" Text="{Binding ScaleX, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0">
                                    <TextBox.InnerLeftContent>
                                        <TextBlock Text="X" Classes="Prefix"/>
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                                <TextBox Grid.Column="2" Classes="VectorInput" Text="{Binding ScaleY, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0">
                                    <TextBox.InnerLeftContent>
                                        <TextBlock Text="Y" Classes="Prefix"/>
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                                <TextBox Grid.Column="3" Classes="VectorInput" Text="{Binding ScaleZ, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InnerLeftContent>
                                        <TextBlock Text="Z" Classes="Prefix"/>
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*, 34">
                <Button Grid.Column="0" 
                        Content="Apply Changes" 
                        Click="OnApplyClick" 
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Center"/>
                <Button Grid.Column="1" 
                        Content="+" 
                        Click="OnAddTransformClick" 
                        Margin="4,0,0,0" 
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>