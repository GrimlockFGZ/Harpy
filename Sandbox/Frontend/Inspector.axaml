<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:HarpyEngine.Sandbox.Editor.Models"
             x:Class="HarpyEngine.Sandbox.Editor.Inspector"
             x:DataType="models:InspectorViewModel"
             x:CompileBindings="True">

    <UserControl.Styles>

        <!-- Section label -->
        <Style Selector="TextBlock.PanelLabel">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="LetterSpacing" Value="1.5"/>
        </Style>

        <!-- Muted field labels -->
        <Style Selector="TextBlock.Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#555555"/>
        </Style>

        <!-- Component section title -->
        <Style Selector="TextBlock.ComponentTitle">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Component badge -->
        <Style Selector="Border.ComponentBadge">
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.ComponentBadgeText">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="#555555"/>
        </Style>

        <!-- Vector input TextBox -->
        <Style Selector="TextBox.VectorInput">
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="MaxHeight" Value="22"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#252525"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style Selector="TextBox.VectorInput:focus /template/ Border#PART_BorderElement">
        </Style>

        <!-- Name TextBox -->
        <Style Selector="TextBox.NameInput">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="BorderBrush" Value="#252525"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style Selector="TextBox.NameInput:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#7c5cfc"/>
        </Style>

        <!-- Apply button: teal accent -->
        <Style Selector="Button.Apply">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Background" Value="#0f1e1a"/>
            <Setter Property="Foreground" Value="#1ca880"/>
            <Setter Property="BorderBrush" Value="#1ca88044"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style Selector="Button.Apply:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#141e1a"/>
        </Style>
        
        

        <!-- Add Component dropdown button -->
        <Style Selector="DropDownButton.AddComp">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="Foreground" Value="#777777"/>
            <Setter Property="BorderBrush" Value="#2e2e2e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style Selector="DropDownButton.AddComp:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2a2a2a"/>
        </Style>

        <!-- Remove component button (per-component header) -->
        <Style Selector="Button.RemoveComp">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.RemoveComp:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2a1414"/>
            <Setter Property="TextElement.Foreground" Value="#ff7070"/>
        </Style>

    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Spacing="0">

            <!-- Panel header with teal accent stripe -->
            <Border Background="#161616"
                    BorderBrush="#1e1e1e"
                    BorderThickness="0,0,0,1"
                    Padding="10,8"
                    Margin="0,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Rectangle Width="3" Height="12" Fill="#1ca880" RadiusX="2" RadiusY="2"/>
                    <TextBlock Classes="PanelLabel" Text="INSPECTOR"/>
                </StackPanel>
            </Border>

            <!-- Entity Name row -->
            <Border Padding="10,10,10,10"
                    BorderBrush="#1e1e1e"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="50, *">
                    <TextBlock Grid.Column="0" Classes="Label" Text="Name" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1"
                             Classes="NameInput"
                             Text="{Binding SelectedEntityName, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </Border>

            <!-- VoxelBlock Component -->
            <Border BorderBrush="#1e1e1e" BorderThickness="0,0,0,1"
                    IsVisible="{Binding HasVoxelBlock}">
                <StackPanel>
                    <Border Background="#181818"
                            Padding="10,6"
                            BorderBrush="#1e1e1e"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                            <!-- Orange accent for VoxelBlock -->
                            <Rectangle Grid.Column="0"
                                       Width="3" Height="10"
                                       Fill="#e07840"
                                       RadiusX="2" RadiusY="2"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Classes="ComponentTitle" Text="VoxelBlock"/>
                            <Border Grid.Column="2" Classes="ComponentBadge" Margin="0,0,6,0">
                                <TextBlock Classes="ComponentBadgeText" Text="component"/>
                            </Border>
                            <Button Grid.Column="3"
                                    Classes="RemoveComp"
                                    Content="✕"
                                    Click="OnRemoveVoxelBlockClick"
                                    ToolTip.Tip="Remove VoxelBlock"/>
                        </Grid>
                    </Border>
                    <Border Padding="10,8">
                        <Grid ColumnDefinitions="56, *">
                            <TextBlock Grid.Column="0" Classes="Label" Text="Type" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       FontSize="10"
                                       Foreground="#cccccc"
                                       Text="{Binding VoxelBlockType}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Transform Component -->
            <Border BorderBrush="#1e1e1e" BorderThickness="0,0,0,1">
                <StackPanel>

                    <!-- Component header -->
                    <Border Background="#181818"
                            Padding="10,6"
                            BorderBrush="#1e1e1e"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                            <!-- Purple accent for Transform -->
                            <Rectangle Grid.Column="0"
                                       Width="3" Height="10"
                                       Fill="#7c5cfc"
                                       RadiusX="2" RadiusY="2"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Classes="ComponentTitle" Text="Transform"/>
                            <Border Grid.Column="2" Classes="ComponentBadge" Margin="0,0,6,0">
                                <TextBlock Classes="ComponentBadgeText" Text="component"/>
                            </Border>
                            <!-- Remove this component -->
                            <Button Grid.Column="3"
                                    Classes="RemoveComp"
                                    Content="✕"
                                    Click="OnRemoveTransformClick"
                                    IsVisible="{Binding HasTransform}"
                                    ToolTip.Tip="Remove Transform"/>
                        </Grid>
                    </Border>

                    <!-- Component fields -->
                    <Border Padding="10,8">
                        <StackPanel Spacing="6">

                            <!-- Position -->
                            <Grid ColumnDefinitions="56, *, *, *">
                                <TextBlock Grid.Column="0" Classes="Label" Text="Position"/>
                                <TextBox Grid.Column="1" Classes="VectorInput"
                                         Text="{Binding PositionX, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,3,0">
                                    <TextBox.InnerLeftContent>
                                        <Border Background="#1e1414" Padding="5,0" Height="22">
                                            <TextBlock Text="X"
                                                       FontSize="9" FontWeight="Bold"
                                                       Foreground="#ff7070"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                                <TextBox Grid.Column="2" Classes="VectorInput"
                                         Text="{Binding PositionY, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,3,0">
                                    <TextBox.InnerLeftContent>
                                        <Border Background="#141e17" Padding="5,0" Height="22">
                                            <TextBlock Text="Y"
                                                       FontSize="9" FontWeight="Bold"
                                                       Foreground="#70ff99"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                                <TextBox Grid.Column="3" Classes="VectorInput"
                                         Text="{Binding PositionZ, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InnerLeftContent>
                                        <Border Background="#14171e" Padding="5,0" Height="22">
                                            <TextBlock Text="Z"
                                                       FontSize="9" FontWeight="Bold"
                                                       Foreground="#7099ff"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                            </Grid>

                            <!-- Scale -->
                            <Grid ColumnDefinitions="56, *, *, *">
                                <TextBlock Grid.Column="0" Classes="Label" Text="Scale"/>
                                <TextBox Grid.Column="1" Classes="VectorInput"
                                         Text="{Binding ScaleX, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,3,0">
                                    <TextBox.InnerLeftContent>
                                        <Border Background="#1a1a1a" Padding="5,0" Height="22">
                                            <TextBlock Text="X"
                                                       FontSize="9" FontWeight="Bold"
                                                       Foreground="#666666"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                                <TextBox Grid.Column="2" Classes="VectorInput"
                                         Text="{Binding ScaleY, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,3,0">
                                    <TextBox.InnerLeftContent>
                                        <Border Background="#1a1a1a" Padding="5,0" Height="22">
                                            <TextBlock Text="Y"
                                                       FontSize="9" FontWeight="Bold"
                                                       Foreground="#666666"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                                <TextBox Grid.Column="3" Classes="VectorInput"
                                         Text="{Binding ScaleZ, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InnerLeftContent>
                                        <Border Background="#1a1a1a" Padding="5,0" Height="22">
                                            <TextBlock Text="Z"
                                                       FontSize="9" FontWeight="Bold"
                                                       Foreground="#666666"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                            </Grid>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>
            
            <TextBlock Text="{Binding Status}" 
                       FontSize="9" 
                       Foreground="#666666"
                       Margin="10,4,10,0"
                       HorizontalAlignment="Center"/>
            
            <!-- Action buttons -->
            <Grid ColumnDefinitions="*, Auto"
                  Margin="10,8,10,8">
                <Button Grid.Column="0"
                        Classes="Apply"
                        Content="Apply Changes"
                        Click="OnApplyClick"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
                <DropDownButton Grid.Column="1"
                                Classes="AddComp"
                                Content="+ Component"
                                Margin="4,0,0,0"
                                HorizontalContentAlignment="Center">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="Transform" Click="OnAddTransformClick"/>
                            <MenuItem Header="VoxelBlock" Click="OnAddVoxelBlockClick"/>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
