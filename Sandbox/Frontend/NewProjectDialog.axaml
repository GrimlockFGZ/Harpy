<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="clr-namespace:HarpyEngine.Sandbox.Editor"
        x:Class="HarpyEngine.Sandbox.Editor.NewProjectDialog"
        x:DataType="editor:NewProjectDialog"
        Title="New Project"
        Width="520" Height="240"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#141414"
        Foreground="#b5b5b5"
        FontSize="12">
    <Window.Styles>
        <Style Selector="TextBlock.Label">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#0f0f0f"/>
            <Setter Property="Foreground" Value="#d0d0d0"/>
            <Setter Property="BorderBrush" Value="#2a2a2a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="Foreground" Value="#b5b5b5"/>
            <Setter Property="BorderBrush" Value="#2a2a2a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="#ffffff"/>
        </Style>
        <Style Selector="Button.Primary">
            <Setter Property="Background" Value="#7c5cfc"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#7c5cfc"/>
        </Style>
        <Style Selector="Button.Primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#6a4de0"/>
            <Setter Property="Foreground" Value="#ffffff"/>
        </Style>
    </Window.Styles>

    <StackPanel Margin="28,24,28,24" Spacing="16">
        <StackPanel Spacing="4">
            <TextBlock Classes="Label" Text="PROJECT NAME"/>
            <TextBox x:Name="ProjectNameBox" PlaceholderText="MyProject"/>
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Classes="Label" Text="LOCATION"/>
            <Grid ColumnDefinitions="*, 8, Auto">
                <TextBox x:Name="LocationBox" Grid.Column="0" PlaceholderText="/home/user/Projects"/>
                <Button Grid.Column="2" Content="Browse..." Click="OnBrowseClicked"/>
            </Grid>
        </StackPanel>
        <TextBlock x:Name="ErrorText"
                   Foreground="#e05555"
                   FontSize="11"
                   IsVisible="False"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
            <Button Content="Cancel" Click="OnCancelClicked"/>
            <Button Content="Create Project" Classes="Primary" Click="OnCreateClicked"/>
        </StackPanel>
    </StackPanel>
</Window>
