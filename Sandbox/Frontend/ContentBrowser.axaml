<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:resources="clr-namespace:HarpyEngine.Resources;assembly=Engine.Resources"
             xmlns:helpers="clr-namespace:HarpyEngine.Sandbox.Helpers"
             xmlns:editor="clr-namespace:HarpyEngine.Sandbox.Editor"
             x:Class="HarpyEngine.Sandbox.Editor.ContentBrowser">

    <ListBox ItemsSource="{Binding $parent[editor:ContentBrowser].ItemsSource}" 
             Background="#2d2d2d"
             BorderThickness="0">
        <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel />
            </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        
        <ListBox.ItemTemplate>
            <DataTemplate x:DataType="resources:AssetInfo">
                <StackPanel Width="90" Margin="5">
                    <Border Height="60" 
                            Background="{Binding Type, Converter={x:Static helpers:TypeToBrushConverter.Instance}}" 
                            CornerRadius="4" />
                    <TextBlock Text="{Binding RelativePath, Converter={x:Static helpers:PathToNameConverter.Instance}}" 
                               FontSize="10" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>