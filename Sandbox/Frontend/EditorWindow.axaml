<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="clr-namespace:HarpyEngine.Sandbox.Editor"
        x:Class="HarpyEngine.Sandbox.Editor.EditorWindow"
        x:DataType="editor:EditorWindow"
        x:CompileBindings ="True"
        Title="Harpy Engine">

    <Grid RowDefinitions="*, 4, 250" ColumnDefinitions="250, 4, *, 4, 300">
        
        <editor:Hierarchy x:Name="HierarchyPanel" Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" Background="#2d2d2d"/>
        
        <GridSplitter Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" Background="Black"/>

        <editor:HarpyViewport x:Name="ViewportPanel" Grid.Row="0" Grid.Column="2" />
        
        <GridSplitter Grid.Row="1" Grid.Column="2" Background="Black" ResizeDirection="Rows"/>
        
        <editor:ContentBrowser Grid.Row="2" Grid.Column="2" 
                               ItemsSource="{Binding $parent[editor:EditorWindow].UiAssets}" />
        <GridSplitter Grid.Row="0" Grid.Column="3" Grid.RowSpan="3" Background="Black"/>
        
        <editor:Inspector x:Name="InspectorPanel" Grid.Row="0" Grid.Column="4" Grid.RowSpan="3" Background="#2d2d2d"/>
        
    </Grid>
</Window>